---
import { vkEmbedSrc } from "../lib/streaming";

interface Props {
  vkOid?: string | null;
  vkId?: string | null;
}

const { vkOid = null, vkId = null } = Astro.props;
const src = vkOid && vkId ? vkEmbedSrc(vkOid, vkId) : "";
---

<iframe
  data-vk-frame
  data-vk-oid={vkOid || undefined}
  data-vk-vid={vkId || undefined}
  title="video"
  class:list={["relative z-0 h-full w-full border-0 pointer-events-none", src ? "opacity-100" : "opacity-0"]}
  src={src || undefined}
  width="1920"
  height="1080"
  allow="autoplay; encrypted-media; fullscreen; picture-in-picture; screen-wake-lock;"
  allowfullscreen
></iframe>

<script>
  import { attachVkSound } from "../lib/vkPlayer";

  for (const frame of document.querySelectorAll("[data-vk-frame]")) {
    if (frame instanceof HTMLIFrameElement) attachVkSound(frame);
  }
</script>
