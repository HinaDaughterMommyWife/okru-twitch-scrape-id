---
interface Props {
}
---

<div class="flex h-full flex-col items-center justify-center gap-3">
  <img src="/sleep.webp" alt="hikari" class="w-40 opacity-40 select-none pointer-events-none" style="filter: grayscale(50%)" />
  <p class="text-gray-400">No hay Stream</p>
  <div class="flex flex-col text-center gap-1">
    <p class="text-sm text-gray-500">Pidele a un Mod o al SapoPerro que escriba <code class="bg-gray-800 text-gray-200 rounded px-1 py-0.5 font-mono text-xs">#okru</code> en el chat de <strong class="twitch-glow font-bold">Twitch</strong></p>
    <p class="text-xs text-gray-600 mb-1"><code class="bg-gray-800/90 text-gray-100 border border-gray-700 rounded px-1.5 py-0.5 font-mono text-[11px]">#okru</code> solo lo pueden usar moderadores</p>
    <p class="text-sm text-gray-500">
      Esta pagina se refrescara automaticamente en <span id="countdown">01:00</span>
    </p>
  </div>
</div>

<style>
  @keyframes twitch-glow {
    0%, 100% {
      color: #9147ff;
      text-shadow: 0 0 4px #9147ff80;
    }
    50% {
      color: #bf94ff;
      text-shadow: 0 0 12px #9147ff, 0 0 24px #9147ffaa;
    }
  }
  .twitch-glow {
    animation: twitch-glow 2s ease-in-out infinite;
  }
</style>

<script>
  const INTERVAL_MS = 60 * 1000;
  const el = document.getElementById("countdown");
  if (el instanceof HTMLElement) {
    const startedAt = Date.now();

    function tick() {
      const elapsed = Date.now() - startedAt;
      const remaining = INTERVAL_MS - elapsed;
      if (remaining <= 0) {
        window.location.reload();
        return;
      }
      const totalSecs = Math.ceil(remaining / 1000);
      const mins = Math.floor(totalSecs / 60).toString().padStart(2, "0");
      const secs = (totalSecs % 60).toString().padStart(2, "0");
      el!.textContent = `${mins}:${secs}`;
    }

    tick();
    setInterval(tick, 1000);
  }
</script>
