---
export const prerender = false;

import VodsPage from "../components/VodsPage.astro";
import { NO_STORE, loadVods, workerEnv } from "../lib/pageData";

Astro.response.headers.set("Cache-Control", NO_STORE);

const data = await loadVods(workerEnv().defaultUser, Astro.url);
if (data.kind === "notFound") return Astro.rewrite("/404");
---

<VodsPage {...data} />
