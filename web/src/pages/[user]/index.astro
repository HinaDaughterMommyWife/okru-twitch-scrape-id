---
export const prerender = false;

import WatchPage from "../../components/WatchPage.astro";
import { NO_STORE, loadWatch, resolveUserParam } from "../../lib/pageData";

const route = resolveUserParam(Astro.params.user, Astro.url, "");
if ("redirect" in route) return Astro.redirect(route.redirect, 301);

const data = await loadWatch(route.slug, Astro.url);
if (data.kind === "notFound") return Astro.rewrite("/404");

Astro.response.headers.set("Cache-Control", NO_STORE);
---

<WatchPage {...data} />
