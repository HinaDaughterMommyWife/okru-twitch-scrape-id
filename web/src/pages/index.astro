---
export const prerender = false;

import "../styles/global.css";
import { fetchStreamingId } from "../lib/streaming";
import { env } from "cloudflare:workers";
import ErrorMessage from "../components/ErrorMessage.astro";
import NoStream from "../components/NoStream.astro";
import StreamPlayer from "../components/StreamPlayer.astro";
import BraveToast from "../components/BraveToast.astro";

const workerUrl = env.WORKER_URL ?? "";
const authToken = env.WORKER_AUTH_TOKEN ?? "";

Astro.response.headers.set("Cache-Control", "public, s-maxage=5");

const url = new URL(Astro.request.url);
const queryId = url.searchParams.get("id");
const hostname = url.hostname;
const isDev = hostname === "localhost" || hostname === "127.0.0.1";

let vkOid: string | null = null;
let vkId: string | null = null;
let updatedAt: string | null = null;
let errorMessage: string | null = null;

// Manual override via ?id= — accepts:
//   video_1117440596_456239034 | video-1117440596_456239034
//   video1117440596_456239034  | 1117440596_456239034
const idMatch = queryId?.match(/^(?:video[_-]?)?(-?\d+)_(\d+)$/);
if (idMatch) {
  vkOid = idMatch[1];
  vkId = idMatch[2];
} else if (!workerUrl || !authToken) {
  errorMessage = "Configuración incompleta, comuníquese con el administrador.";
} else {
  const result = await fetchStreamingId(workerUrl, authToken);

  if (result.ok) {
    updatedAt = result.data.updated_at;
    vkOid = result.data.vk_oid !== "NOT_FOUND" ? result.data.vk_oid : null;
    vkId = result.data.vk_id !== "NOT_FOUND" ? result.data.vk_id : null;
  } else if (result.error === "no streaming id stored yet") {
    updatedAt = new Date(Date.now() - 10_000).toISOString();
  } else {
    errorMessage = result.error;
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>SapoPerro Ruso</title>
    <script defer src="https://assets.onedollarstats.com/stonks.js" data-debug={isDev ? "watch.shonensemanal.site" : undefined}></script>
  </head>
  <body class="m-0 h-dvh w-screen overflow-hidden bg-[#0e0e10] text-white">
    {errorMessage && <ErrorMessage message={errorMessage} />}

    {!errorMessage && !vkOid && <NoStream />}

    {vkOid && vkId && <StreamPlayer vkOid={vkOid} vkId={vkId} hostname={hostname} />}

    {vkOid && <BraveToast />}
  </body>
</html>
