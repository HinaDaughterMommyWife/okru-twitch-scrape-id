---
export const prerender = false;

import WatchPage from "../components/WatchPage.astro";
import { NO_STORE, loadWatch, workerEnv } from "../lib/pageData";

Astro.response.headers.set("Cache-Control", NO_STORE);

const data = await loadWatch(workerEnv().defaultUser, Astro.url);
---

{data.kind === "notFound" ? (
    <WatchPage
        kind="error"
        message="El canal por defecto aún no está configurado."
    />
) : (
    <WatchPage {...data} />
)}
