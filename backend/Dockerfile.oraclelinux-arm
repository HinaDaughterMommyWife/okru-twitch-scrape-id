# Cross-compile okru-backend for Oracle Linux 8 ARM (aarch64, glibc 2.28).
# Runs on your PC's native arch (x86_64/WSL) — no QEMU / no ARM container needed.
#
#   make build-oracle-arm
# Result: ../arm/okru-backend  (ELF aarch64)

# ---- builder (host platform) ----
FROM --platform=$BUILDPLATFORM ghcr.io/rust-cross/cargo-zigbuild:latest AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src

# OL8 ships glibc 2.28; pin that as the minimum.
RUN cargo zigbuild --release --target aarch64-unknown-linux-gnu.2.28 --bin okru-backend \
    && cp target/aarch64-unknown-linux-gnu/release/okru-backend /okru-backend

# ---- export stage (for --output type=local) ----
FROM scratch AS export
COPY --from=builder /okru-backend /okru-backend
