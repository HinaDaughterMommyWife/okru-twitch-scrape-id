# Cross-compile okru-backend + okru-tui for Oracle Linux 8 ARM (aarch64, glibc 2.28).
# Runs on your PC's native arch (x86_64/WSL) — no QEMU / no ARM container needed.
# Build context = workspace root (backend/ + tui/ share one Cargo workspace).
#
#   make build-oracle-arm
# Result: ../arm/okru-backend + ../arm/okru-tui  (ELF aarch64)

# ---- builder (host platform) ----
FROM --platform=$BUILDPLATFORM ghcr.io/rust-cross/cargo-zigbuild:latest AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
COPY tui ./tui

# OL8 ships glibc 2.28; pin that as the minimum. rusqlite's bundled SQLite compiles with zig cc.
RUN cargo zigbuild --release --target aarch64-unknown-linux-gnu.2.28 \
        -p okru-backend -p okru-tui --bin okru-backend --bin okru-tui \
    && cp target/aarch64-unknown-linux-gnu/release/okru-backend /okru-backend \
    && cp target/aarch64-unknown-linux-gnu/release/okru-tui /okru-tui

# ---- export stage (for --output type=local) ----
FROM scratch AS export
COPY --from=builder /okru-backend /okru-backend
COPY --from=builder /okru-tui /okru-tui
